{
  "info": {
    "name": "Restful-Booker - Booking lifecycle API tests",
    "description": "Chained flow: Auth -> Create -> Update -> Verify -> Delete, with JSON schema, status code and payload assertions plus negative tests.\n\nRun with Newman: npm test",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "utils",
      "value": "({\n  expectStatus(code) {\n    pm.test('Status code is ' + code, () => pm.response.to.have.status(code));\n  },\n  expectFastResponse(ms) {\n    pm.test('Response time is below ' + ms + ' ms', () => pm.expect(pm.response.responseTime).to.be.below(ms));\n  },\n  expectJson() {\n    pm.test('Content-Type is JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));\n  },\n  expectSchema(name) {\n    const schema = JSON.parse(pm.collectionVariables.get(name));\n    pm.test('Body matches the ' + name + ' JSON schema', () => pm.response.to.have.jsonSchema(schema));\n  },\n  expectBookingEquals(actual, expected, label) {\n    pm.test(label + ': firstname, lastname, totalprice, depositpaid, dates and additionalneeds match', () => {\n      pm.expect(actual.firstname).to.eql(expected.firstname);\n      pm.expect(actual.lastname).to.eql(expected.lastname);\n      pm.expect(actual.totalprice).to.eql(expected.totalprice);\n      pm.expect(actual.depositpaid).to.eql(expected.depositpaid);\n      pm.expect(actual.bookingdates).to.eql(expected.bookingdates);\n      pm.expect(actual.additionalneeds).to.eql(expected.additionalneeds);\n    });\n  },\n  isoDate(daysFromToday) {\n    const d = new Date();\n    d.setUTCDate(d.getUTCDate() + daysFromToday);\n    return d.toISOString().slice(0, 10);\n  },\n})"
    },
    {
      "key": "bookingSchema",
      "value": "{\"type\":\"object\",\"required\":[\"firstname\",\"lastname\",\"totalprice\",\"depositpaid\",\"bookingdates\"],\"properties\":{\"firstname\":{\"type\":\"string\",\"minLength\":1},\"lastname\":{\"type\":\"string\",\"minLength\":1},\"totalprice\":{\"type\":\"number\"},\"depositpaid\":{\"type\":\"boolean\"},\"bookingdates\":{\"type\":\"object\",\"required\":[\"checkin\",\"checkout\"],\"properties\":{\"checkin\":{\"type\":\"string\",\"pattern\":\"^\\\\d{4}-\\\\d{2}-\\\\d{2}$\"},\"checkout\":{\"type\":\"string\",\"pattern\":\"^\\\\d{4}-\\\\d{2}-\\\\d{2}$\"}}},\"additionalneeds\":{\"type\":\"string\"}}}"
    },
    {
      "key": "createResponseSchema",
      "value": "{\"type\":\"object\",\"required\":[\"bookingid\",\"booking\"],\"properties\":{\"bookingid\":{\"type\":\"integer\",\"minimum\":1},\"booking\":{\"type\":\"object\",\"required\":[\"firstname\",\"lastname\",\"totalprice\",\"depositpaid\",\"bookingdates\"],\"properties\":{\"firstname\":{\"type\":\"string\",\"minLength\":1},\"lastname\":{\"type\":\"string\",\"minLength\":1},\"totalprice\":{\"type\":\"number\"},\"depositpaid\":{\"type\":\"boolean\"},\"bookingdates\":{\"type\":\"object\",\"required\":[\"checkin\",\"checkout\"],\"properties\":{\"checkin\":{\"type\":\"string\",\"pattern\":\"^\\\\d{4}-\\\\d{2}-\\\\d{2}$\"},\"checkout\":{\"type\":\"string\",\"pattern\":\"^\\\\d{4}-\\\\d{2}-\\\\d{2}$\"}}},\"additionalneeds\":{\"type\":\"string\"}}}}}"
    },
    {
      "key": "tokenSchema",
      "value": "{\"type\":\"object\",\"required\":[\"token\"],\"properties\":{\"token\":{\"type\":\"string\",\"minLength\":10}},\"additionalProperties\":false}"
    },
    {
      "key": "createdBooking",
      "value": ""
    },
    {
      "key": "updatedBooking",
      "value": ""
    },
    {
      "key": "createBody",
      "value": ""
    },
    {
      "key": "updateBody",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Health check",
      "item": [
        {
          "name": "GET /ping - API is up",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const utils = eval(pm.collectionVariables.get('utils'));",
                  "utils.expectStatus(201);",
                  "utils.expectFastResponse(5000);",
                  "pm.test('Body is \"Created\"', () => pm.expect(pm.response.text()).to.eql('Created'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ping",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ping"
              ]
            },
            "description": "Smoke check before the flow. Restful-Booker answers 201 Created (documented quirk)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "POST /auth - generate token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const utils = eval(pm.collectionVariables.get('utils'));",
                  "utils.expectStatus(200);",
                  "utils.expectJson();",
                  "utils.expectSchema('tokenSchema');",
                  "const token = pm.response.json().token;",
                  "pm.test('Token is a non-empty string', () => pm.expect(token).to.be.a('string').and.not.empty);",
                  "pm.environment.set('token', token);",
                  "console.log('Saved token for later requests');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth"
              ]
            },
            "description": "Step 1. Saves the token as the environment variable `token` for the update and delete requests."
          },
          "response": []
        },
        {
          "name": "POST /auth - NEGATIVE wrong password returns no token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 (current behaviour, BUG-07) or 401 (correct)', () => pm.expect(pm.response.code).to.be.oneOf([200, 401]));",
                  "const body = pm.response.json();",
                  "pm.test('No token is issued', () => pm.expect(body).to.not.have.property('token'));",
                  "pm.test('Reason is \"Bad credentials\"', () => pm.expect(body.reason).to.eql('Bad credentials'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"wrong-password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth"
              ]
            },
            "description": "Negative: wrong password must not produce a token.\n\nKnown defect BUG-07: the API answers 200 OK with {\"reason\":\"Bad credentials\"} instead of 401. The test accepts 200 or 401 so the suite stays green, and asserts the part that matters: no token is issued."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Booking lifecycle (chained)",
      "item": [
        {
          "name": "POST /booking - create booking",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const utils = eval(pm.collectionVariables.get('utils'));",
                  "// Test data is generated here, not hard-coded in the body, so every run is unique and isolated.",
                  "const runId = Date.now().toString(36);",
                  "const booking = {",
                  "  firstname: 'QA' + runId,",
                  "  lastname: pm.variables.replaceIn('{{$randomLastName}}'),",
                  "  totalprice: Math.floor(Math.random() * 400) + 100,",
                  "  depositpaid: true,",
                  "  bookingdates: { checkin: utils.isoDate(30), checkout: utils.isoDate(33) },",
                  "  additionalneeds: 'Breakfast',",
                  "};",
                  "pm.collectionVariables.set('createdBooking', JSON.stringify(booking));",
                  "pm.collectionVariables.set('createBody', JSON.stringify(booking));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const utils = eval(pm.collectionVariables.get('utils'));",
                  "utils.expectStatus(200);",
                  "utils.expectJson();",
                  "utils.expectFastResponse(5000);",
                  "utils.expectSchema('createResponseSchema');",
                  "const body = pm.response.json();",
                  "const sent = JSON.parse(pm.collectionVariables.get('createdBooking'));",
                  "utils.expectBookingEquals(body.booking, sent, 'Response echoes the sent booking');",
                  "pm.environment.set('bookingId', body.bookingid);",
                  "console.log('Created bookingId ' + body.bookingid);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{{createBody}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/booking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ]
            },
            "description": "Step 2. Builds unique test data in the pre-request script, creates the booking and saves `bookingId` from the response."
          },
          "response": []
        },
        {
          "name": "GET /booking/:id - read created booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const utils = eval(pm.collectionVariables.get('utils'));",
                  "utils.expectStatus(200);",
                  "utils.expectJson();",
                  "utils.expectSchema('bookingSchema');",
                  "const sent = JSON.parse(pm.collectionVariables.get('createdBooking'));",
                  "utils.expectBookingEquals(pm.response.json(), sent, 'Stored booking');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingId}}"
              ]
            },
            "description": "Confirms the booking was stored exactly as sent, using the extracted bookingId."
          },
          "response": []
        },
        {
          "name": "PUT /booking/:id - NEGATIVE no token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const utils = eval(pm.collectionVariables.get('utils'));",
                  "utils.expectStatus(403);",
                  "pm.test('Body is \"Forbidden\"', () => pm.expect(pm.response.text()).to.eql('Forbidden'));",
                  "const sent = JSON.parse(pm.collectionVariables.get('createdBooking'));",
                  "// Follow-up read proves the refused request changed nothing.",
                  "pm.sendRequest({ url: pm.variables.replaceIn('{{baseUrl}}/booking/{{bookingId}}'), method: 'GET', header: { Accept: 'application/json' } }, (err, res) => {",
                  "  pm.test('Booking is unchanged after the refused update', () => {",
                  "    pm.expect(err).to.be.null;",
                  "    pm.expect(res.json().firstname).to.eql(sent.firstname);",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"Hacker\",\n  \"lastname\": \"NoToken\",\n  \"totalprice\": 1,\n  \"depositpaid\": false,\n  \"bookingdates\": {\n    \"checkin\": \"2030-01-01\",\n    \"checkout\": \"2030-01-02\"\n  },\n  \"additionalneeds\": \"None\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingId}}"
              ]
            },
            "description": "Negative: an update without a Cookie or Authorization header must be refused, and the booking must not change."
          },
          "response": []
        },
        {
          "name": "PUT /booking/:id - NEGATIVE invalid token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const utils = eval(pm.collectionVariables.get('utils'));",
                  "utils.expectStatus(403);",
                  "pm.test('Body is \"Forbidden\"', () => pm.expect(pm.response.text()).to.eql('Forbidden'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "token=invalid-token-123"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"Hacker\",\n  \"lastname\": \"BadToken\",\n  \"totalprice\": 1,\n  \"depositpaid\": false,\n  \"bookingdates\": {\n    \"checkin\": \"2030-01-01\",\n    \"checkout\": \"2030-01-02\"\n  },\n  \"additionalneeds\": \"None\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingId}}"
              ]
            },
            "description": "Negative: a made-up token must be refused with 403."
          },
          "response": []
        },
        {
          "name": "PUT /booking/:id - update with token",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const utils = eval(pm.collectionVariables.get('utils'));",
                  "const created = JSON.parse(pm.collectionVariables.get('createdBooking'));",
                  "const updated = {",
                  "  ...created,",
                  "  firstname: created.firstname + '-Updated',",
                  "  totalprice: created.totalprice + 100,",
                  "  depositpaid: false,",
                  "  bookingdates: { checkin: utils.isoDate(40), checkout: utils.isoDate(45) },",
                  "  additionalneeds: 'Late checkout',",
                  "};",
                  "pm.collectionVariables.set('updatedBooking', JSON.stringify(updated));",
                  "pm.collectionVariables.set('updateBody', JSON.stringify(updated));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const utils = eval(pm.collectionVariables.get('utils'));",
                  "utils.expectStatus(200);",
                  "utils.expectJson();",
                  "utils.expectSchema('bookingSchema');",
                  "const expected = JSON.parse(pm.collectionVariables.get('updatedBooking'));",
                  "utils.expectBookingEquals(pm.response.json(), expected, 'Update response');"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "token={{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{{updateBody}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingId}}"
              ]
            },
            "description": "Step 3. Uses the extracted bookingId and the token from step 1. Changes firstname, totalprice, depositpaid, dates and additionalneeds."
          },
          "response": []
        },
        {
          "name": "GET /booking/:id - verify update",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const utils = eval(pm.collectionVariables.get('utils'));",
                  "utils.expectStatus(200);",
                  "utils.expectSchema('bookingSchema');",
                  "const body = pm.response.json();",
                  "const expected = JSON.parse(pm.collectionVariables.get('updatedBooking'));",
                  "const created = JSON.parse(pm.collectionVariables.get('createdBooking'));",
                  "pm.test('Updated firstname is saved', () => pm.expect(body.firstname).to.eql(expected.firstname));",
                  "pm.test('Updated totalprice is saved (+100)', () => pm.expect(body.totalprice).to.eql(created.totalprice + 100));",
                  "pm.test('Updated additionalneeds is saved', () => pm.expect(body.additionalneeds).to.eql('Late checkout'));",
                  "pm.test('Unchanged lastname is kept', () => pm.expect(body.lastname).to.eql(created.lastname));",
                  "utils.expectBookingEquals(body, expected, 'Stored booking after update');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingId}}"
              ]
            },
            "description": "Step 4. Reads the booking back and asserts that the specific update was saved."
          },
          "response": []
        },
        {
          "name": "DELETE /booking/:id - NEGATIVE no token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const utils = eval(pm.collectionVariables.get('utils'));",
                  "utils.expectStatus(403);",
                  "pm.sendRequest({ url: pm.variables.replaceIn('{{baseUrl}}/booking/{{bookingId}}'), method: 'GET', header: { Accept: 'application/json' } }, (err, res) => {",
                  "  pm.test('Booking still exists after the refused delete', () => pm.expect(res.code).to.eql(200));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingId}}"
              ]
            },
            "description": "Negative: delete without a token must be refused and the booking must still exist."
          },
          "response": []
        },
        {
          "name": "DELETE /booking/:id - clean up",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const utils = eval(pm.collectionVariables.get('utils'));",
                  "utils.expectStatus(201);"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Cookie",
                "value": "token={{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingId}}"
              ]
            },
            "description": "Step 5. Deletes the test booking. Restful-Booker answers 201 Created (documented)."
          },
          "response": []
        },
        {
          "name": "GET /booking/:id - confirm deleted",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const utils = eval(pm.collectionVariables.get('utils'));",
                  "utils.expectStatus(404);",
                  "pm.environment.unset('bookingId');",
                  "pm.environment.unset('token');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingId}}"
              ]
            },
            "description": "Confirms the clean-up worked, then clears the chained variables."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Negative - GET unknown booking",
      "item": [
        {
          "name": "GET /booking/:id - NEGATIVE id does not exist",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const utils = eval(pm.collectionVariables.get('utils'));",
                  "utils.expectStatus(404);",
                  "pm.test('Body is \"Not Found\"', () => pm.expect(pm.response.text()).to.eql('Not Found'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/999999999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "999999999"
              ]
            },
            "description": "Negative: an unknown id must return 404."
          },
          "response": []
        }
      ]
    }
  ]
}
